{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Studio-Manfred/manfred-design-system/manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "package", "components", "tokens", "peerDependencies", "setup"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object", "required": ["name", "version"], "additionalProperties": false,
      "properties": { "name": { "const": "@studio-manfred/manfred-design-system" }, "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" } }
    },
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "group", "description", "storybook", "extendsDom", "props"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z]" },
          "group": { "type": "string" },
          "description": { "type": "string" },
          "storybook": { "type": ["string", "null"] },
          "extendsDom": { "type": "boolean" },
          "props": {
            "type": "array",
            "items": {
              "type": "object", "required": ["name", "type", "required", "default", "description"], "additionalProperties": false,
              "properties": {
                "name": { "type": "string" }, "type": { "type": "string" }, "required": { "type": "boolean" },
                "default": { "type": ["string", "null"] }, "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "tokens": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "value", "layer"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^--" }, "value": { "type": "string" },
          "layer": { "enum": ["primitive", "semantic", "contract"] }, "utility": { "type": "string" }
        }
      }
    },
    "peerDependencies": { "type": "object", "additionalProperties": { "type": "string" } },
    "setup": {
      "type": "object", "required": ["cssImports", "sourceGlob", "registry", "mcp", "nextUseClientSince"], "additionalProperties": false,
      "properties": {
        "cssImports": { "type": "array", "items": { "type": "string" } },
        "sourceGlob": { "type": "string" },
        "registry": { "type": "object", "required": ["scope", "url"], "properties": { "scope": { "type": "string" }, "url": { "type": "string" } } },
        "mcp": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string" } } },
        "nextUseClientSince": { "type": "string" }
      }
    }
  }
}
